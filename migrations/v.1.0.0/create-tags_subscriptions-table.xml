<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <changeSet id="create-subscriptions-table" author="kirill">
        <createTable tableName="tags_subscriptions">
            <column name="chat_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="link_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="tag" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="tags_subscriptions"
            baseColumnNames="chat_id, link_id"
            constraintName="fk_tags_subscriptions_chat_id_link_id"
            referencedTableName="subscriptions"
            referencedColumnNames="chat_id, link_id"
            onDelete="CASCADE"/>

        <addPrimaryKey
            tableName="tags_subscriptions"
            columnNames="link_id, chat_id, tag"
            constraintName="pk_tags_subscriptions"/>
    </changeSet>

</databaseChangeLog>
