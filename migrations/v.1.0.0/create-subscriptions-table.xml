<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <changeSet id="create-subscriptions-table" author="kirill">
        <createTable tableName="subscriptions">
            <column name="chat_id" type="bigint">
                <constraints nullable="false"
                             foreignKeyName="fk_subscriptions_chat_id"
                             references="chats(id)"/>
            </column>
            <column name="link_id" type="bigint">
                <constraints nullable="false"
                             foreignKeyName="fk_links_id"
                             references="links(id)"/>
            </column>
        </createTable>

        <addPrimaryKey
            tableName="subscriptions"
            columnNames="chat_id,link_id"
            constraintName="pk_subscriptions"/>
    </changeSet>

</databaseChangeLog>
