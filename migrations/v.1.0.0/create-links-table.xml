<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <changeSet id="create-links-table" author="kirill">
        <createTable tableName="links">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="type" type="varchar(30)">
                <constraints nullable="false"/>
            </column>
            <column name="url" type="varchar(200)">
                <constraints nullable="false"/>
            </column>
            <column name="last_check" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="links" indexName="ix_links_last_check">
            <column name="last_check"/>
        </createIndex>
        <addUniqueConstraint tableName="links"
                             columnNames="url"
                             constraintName="links_uniq_url"/>
    </changeSet>

</databaseChangeLog>
